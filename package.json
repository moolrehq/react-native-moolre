{
  "name": "react-native-moolre",
  "version": "0.1.3",
  "description": "This React Native plugin enables seamless integration of Moolre Payments into your React Native application.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-moolre-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moolrehq/react-native-moolre.git"
  },
  "author": "Moolre HQ (https://github.com/moolrehq)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/moolrehq/react-native-moolre/issues"
  },
  "homepage": "https://github.com/moolrehq/react-native-moolre#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "example",
    "packages/react-native-moolre"
  ],
  "packageManager": "yarn@3.6.1",
  "dependencies": {
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-webview": "13.13.5"
  },
  "resolutions": {
    "react": "19.0.0",
    "react-native": "0.79.2"
  },
  "peerDependencies": {
    "expo": "~53.0.9",
    "react": "19.0.0",
    "react-native": "0.79.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/babel-preset": "0.78.2",
    "@react-native/eslint-config": "^0.78.0",
    "@release-it/conventional-changelog": "^9.0.2",
    "@tsconfig/react-native": "^3.0.5",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.0.12",
    "@types/react-native": "^0.73.0",
    "commitlint": "^19.6.1",
    "del-cli": "^5.1.0",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "react-native-builder-bob": "^0.40.8",
    "release-it": "^17.10.0",
    "typescript": "^5.2.2"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.50.2"
  }
}
